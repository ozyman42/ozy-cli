{
  "$schema": "./package.schema.json",
  "name": "@ozyman42/ozy-cli",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Tools for setting up new packages, configuring with git & npm",
  "type": "module",
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "jive:cicd:deploy:url": "jive-library cicd deploy-url",
    "jive:dev:precommit": "",
    "build:local": "bun src/scripts/kill-existing-agent.ts && bun ../../jive-abstract-library/src/entrypoints/jive-library.ts cicd build",
    "install:local": "bun run build:local && bun uninstall --global @ozyman42/ozy-cli ; bun add -g \"$(pwd)/dist/base\"",
    "prepare": "[ \"$CI\" = \"true\" ] || lefthook install"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/bs58": "^5.0.0",
    "@types/bun": "^1.3.14",
    "@types/ejs": "^3.1.5",
    "@types/expand-tilde": "^2.0.2",
    "@types/friendly-words": "^1.2.2",
    "ejs": "^6.0.1",
    "jsonc-parser": "^3.3.1",
    "lefthook": "latest",
    "typescript": "^5.9.3",
    "jive-abstract-library": "0.1.8"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0",
    "@ozyman42/interactive-cli-select": "^0.2.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "chromium-bidi": "^13.0.0",
    "commander": "^13.1.0",
    "effect": "^4.0.0",
    "effective-modules": "0.3.5",
    "expand-tilde": "^2.0.2",
    "friendly-words": "^1.3.1",
    "playwright-core": "^1.56.0",
    "ssh-config": "^5.0.3",
    "zod": "^3.24.2"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest"
    },
    "library": {
      "daemons": [
        "ozy-signing-agent"
      ]
    }
  }
}
