{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "allOf": [
        {
          "minLength": 1
        },
        {
          "pattern": "^(?:@[^/]+\\/[^/]+|(?!@)[^/]+)$"
        }
      ]
    },
    "version": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "allOf": [
                    {
                      "minLength": 1
                    }
                  ]
                },
                "url": {
                  "type": "string",
                  "allOf": [
                    {
                      "minLength": 1
                    }
                  ]
                },
                "directory": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string",
                          "allOf": [
                            {
                              "minLength": 1
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "minLength": 1
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "jive": {
      "type": "object",
      "properties": {
        "cicd": {
          "type": "object",
          "properties": {
            "deployVerb": {
              "type": "string",
              "description": "If you want the pipeline step to display something other than \"Deploy to\". For example \"Publish Tag\" for publishing packages."
            },
            "runsOn": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "allOf": [
                        {
                          "minLength": 1
                        }
                      ]
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "allOf": [
                          {
                            "minLength": 1
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "group": {
                      "type": "string",
                      "allOf": [
                        {
                          "minLength": 1
                        }
                      ]
                    },
                    "labels": {
                      "anyOf": [
                        {
                          "type": "string",
                          "allOf": [
                            {
                              "minLength": 1
                            }
                          ]
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "allOf": [
                              {
                                "minLength": 1
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "group"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "group": {
                      "type": "string",
                      "allOf": [
                        {
                          "minLength": 1
                        }
                      ]
                    },
                    "labels": {
                      "anyOf": [
                        {
                          "type": "string",
                          "allOf": [
                            {
                              "minLength": 1
                            }
                          ]
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "allOf": [
                              {
                                "minLength": 1
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "labels"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "The runs-on value to build and deploy on: a string, a string array, or a {group, labels} object (the same shapes GHA's own \"runs-on\" key accepts for a job — see https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#choosing-self-hosted-runners). Defaults to \"ubuntu-latest\"."
            },
            "deployBranches": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "description": "Object mapping each deployable branch to its ordered list of environments to deploy to (e.g. {\"main\": [\"Staging\",\"Production\"], \"onebox\": [\"OneBox\"]}). Defaults to {} (no branch deploys)."
            },
            "runOnPullRequests": {
              "type": "boolean",
              "description": "If true, opening/pushing to a pull request runs the build & unit-test pipeline, and also the deploy pipeline if preview deploys are enabled."
            },
            "enablePreviewDeploys": {
              "type": "boolean",
              "description": "If true, any workflow_dispatch event on a branch not in deployBranches also deploys a \"Preview\" environment after the build step (build step is run regardless of preview deploy). In addition preview deploys will also run on PR creation and change if runOnPullRequests is set to true."
            }
          },
          "required": [
            "runOnPullRequests",
            "enablePreviewDeploys"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cicd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "license",
    "name",
    "jive"
  ],
  "additionalProperties": true
}