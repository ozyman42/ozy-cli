import { mkdir } from "node:fs/promises";

const packageJson = await Bun.file("package.json").json();
delete packageJson.scripts;
delete packageJson.devDependencies;

await mkdir("dist", { recursive: true });
await Bun.write("dist/package.json", `${JSON.stringify(packageJson, null, 2)}\n`);

const npmPackageSpec = <%- JSON.stringify(npmPackageSpec) %>;
await Bun.$`bunx ${npmPackageSpec} pack dist --pack-destination dist --ignore-scripts --loglevel error`;
